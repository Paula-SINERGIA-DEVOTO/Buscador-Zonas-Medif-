],[9405,"RÍO GALLEGOS","Patagonia","Localidades de Santa Cruz","Santa Cruz"],[9407,"RÍO GALLEGOS","Patagonia","Localidades de Santa Cruz","Santa Cruz"],[9410,"COMODORO","Patagonia","Localidades de Santa Cruz y Tierra Del Fuego","Santa Cruz / Tierra Del Fuego"],[9412,"RÍO GRANDE","Patagonia","Localidades de Tierra Del Fuego","Tierra Del Fuego"],[9420,"RÍO GRANDE","Patagonia","Localidades de Santa Cruz y Tierra Del Fuego","Santa Cruz / Tierra Del Fuego"]];

const DATA_MAP = new Map();
DATA.forEach(row => DATA_MAP.set(row[0], row));

/* ---------- Lookup por dígitos ----------
   Un único <input> real (invisible) recibe el tacto/teclado y cubre toda
   el área de las 4 celdas visuales. Esto evita los problemas de foco
   "salto de casilla" que fallan en Safari/iOS cuando se usan 4 <input>
   separados, y funciona igual en Android y en navegadores de escritorio. */
const cpRealInput = document.getElementById('cpRealInput');
const cpBoxEls = [
  document.getElementById('cpBox0'),
  document.getElementById('cpBox1'),
  document.getElementById('cpBox2'),
  document.getElementById('cpBox3'),
];
const btn = document.getElementById('btnConsultar');
const btnLimpiar = document.getElementById('btnLimpiar');
const hint = document.getElementById('hint');
const resultado = document.getElementById('resultado');
const resultadoContenido = document.getElementById('resultadoContenido');
const cpInfo = document.getElementById('cpInfo');
const infoLocalidad = document.getElementById('infoLocalidad');
const infoProvincia = document.getElementById('infoProvincia');
const cpInfoNota = document.getElementById('cpInfoNota');
const HINT_DEFAULT = hint.textContent;

function currentCP(){
  return cpRealInput.value;
}

function renderBoxes(){
  const val = cpRealInput.value;
  cpBoxEls.forEach((box, i) => {
    box.textContent = val[i] || '';
    box.classList.toggle('filled', i < val.length);
    box.classList.toggle('active', i === val.length);
  });
}

function updateButtonState(){
  const val = currentCP();
  const valido = val.length === 4 && !/\D/.test(val);
  btn.classList.toggle('inactive', !valido);
}

cpRealInput.addEventListener('input', () => {
  cpRealInput.value = cpRealInput.value.replace(/\D/g, '').slice(0, 4);
  renderBoxes();
  updateButtonState();
  if (currentCP().length === 4) buscar();
});

cpRealInput.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && currentCP().length === 4){
    buscar();
  }
});

cpRealInput.addEventListener('focus', () => renderBoxes());
cpRealInput.addEventListener('blur', () => {
  cpBoxEls.forEach(box => box.classList.remove('active'));
});

btn.addEventListener('click', buscar);
btnLimpiar.addEventListener('click', limpiar);

function limpiar(){
  cpRealInput.value = '';
  renderBoxes();
  updateButtonState();
  hint.textContent = HINT_DEFAULT;
  hint.classList.remove('error');
  cpInfo.classList.remove('show');
  cpInfoNota.classList.remove('show');
  resultadoContenido.innerHTML = '';
  resultado.classList.remove('show');
  cpRealInput.focus();
}

function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function buscar(){
  const cpStr = currentCP();
  if (cpStr.length !== 4 || /\D/.test(cpStr)){
    hint.textContent = 'Ingresá los 4 dígitos del código postal.';
    hint.classList.add('error');
    return;
  }
  hint.textContent = HINT_DEFAULT;
  hint.classList.remove('error');

  const cp = parseInt(cpStr, 10);
  const row = DATA_MAP.get(cp);

  resultado.classList.remove('show');
  void resultado.offsetWidth; // reinicia animación
  cpInfo.classList.remove('show');
  cpInfoNota.classList.remove('show');

  if (!row){
    resultadoContenido.innerHTML = `
      <div class="not-found">
        <span class="icono">&#9888;&#65039;</span>
        <div>
          <h3>No encontramos el código postal ${escapeHtml(cpStr)}</h3>
          <p>Verificá que el código sea correcto. Si el dato es correcto y no aparece en la base, contactá a tu referente de Soporte de Ventas o de Alianzas Comerciales de Medifé.</p>
        </div>
      </div>`;
    resultado.classList.add('show');
    return;
  }

  const [ , sucursal, lista, localidad, provincia ] = row;

  infoLocalidad.textContent = localidad ? localidad : 'No disponible';
  infoProvincia.textContent = provincia ? provincia : 'No disponible';
  cpInfo.classList.add('show');
  const compartido = !!(localidad && localidad.trim().toLowerCase().startsWith('localidades de'));
  cpInfoNota.classList.toggle('show', compartido);

  const html = `
    <div class="datos">
      <div class="dato-item">
        <p class="label">Código postal</p>
        <p class="valor cp-shown">${escapeHtml(cpStr)}</p>
      </div>
      <div class="dato-item">
        <p class="label">Sucursal</p>
        <p class="valor">${escapeHtml(sucursal)}</p>
      </div>
      <div class="dato-item">
        <p class="label">Lista de precios</p>
        <p class="valor">${escapeHtml(lista)}</p>
      </div>
    </div>
    <div class="copy-row">
      <button class="copy-btn" id="copyBtn">Copiar resultado</button>
    </div>`;

  resultadoContenido.innerHTML = html;
  resultado.classList.add('show');

  const copyBtn = document.getElementById('copyBtn');
  copyBtn.addEventListener('click', () => {
    const resumen = `CP ${cpStr} | Localidad: ${localidad || 'No disponible'} | Provincia: ${provincia || 'No disponible'} | Sucursal: ${sucursal} | Lista de precios: ${lista}`;
    copiarTexto(resumen, copyBtn);
  });
}

function copiarTexto(texto, btnEl){
  const marcarCopiado = () => {
    const original = btnEl.textContent;
    btnEl.textContent = 'Copiado ✓';
    btnEl.classList.add('copied');
    setTimeout(() => { btnEl.textContent = original; btnEl.classList.remove('copied'); }, 1800);
  };
  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(texto).then(marcarCopiado).catch(() => fallbackCopy(texto, marcarCopiado));
  } else {
    fallbackCopy(texto, marcarCopiado);
  }
}

function fallbackCopy(texto, cb){
  const ta = document.createElement('textarea');
  ta.value = texto;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.focus(); ta.select();
  try{ document.execCommand('copy'); cb(); } catch(e){ /* silencioso */ }
  document.body.removeChild(ta);
}

/* Estado y foco inicial */
renderBoxes();
cpRealInput.focus();
</script>
